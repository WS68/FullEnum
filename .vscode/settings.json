{
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false
  },
  "csharp.format.enable": true,
  "csharp.format.indent.braces": true,
  "csharp.format.indent.blockContents": true,
  "csharp.format.indent.switchSection": true,
  "csharp.format.newLines.bracesInControlBlocks": true,
  "csharp.format.newLines.bracesInMethods": true,
  "csharp.format.newLines.bracesInProperties": true,
  "csharp.format.newLines.bracesInTypes": true,
  "csharp.format.newLines.rightBraceInNewLine": true,
  "csharp.format.space.afterComma": true,
  "csharp.format.space.afterKeywordsInControlFlowStatements": true,
  "csharp.format.space.beforeOpenBraceInControlBlock": true,
  "csharp.format.space.beforeOpenBraceInMethods": true,
  "csharp.format.space.beforeOpenBraceInProperties": true,
  "csharp.format.space.beforeOpenBraceInTypes": true,
  "csharp.format.space.withinEmptyBraces": false,
  "csharp.format.space.withinParentheses": false,
  "csharp.format.space.withinSquareBrackets": false,
  "csharp.format.space.aroundBinaryOperators": true,
  "csharp.format.space.aroundAssignmentOperators": true,
  "csharp.format.space.beforeMethodCallParentheses": false,
  "csharp.format.space.beforeMethodDeclarationParentheses": false,
  "csharp.format.space.beforeOpenParenInControlFlowStatements": true,
  "csharp.format.space.beforeOpenParenInMethodCall": false,
  "csharp.format.space.beforeOpenParenInMethodDeclaration": false,
  "csharp.format.newLines.elseOnClosingBrace": true,
  "csharp.format.newLines.catchOnClosingBrace": true,
  "csharp.format.newLines.finallyOnClosingBrace": true,
  "csharp.format.newLines.whileOnClosingBrace": true,
  "csharp.format.newLines.inAQueryExpression": true,
  "csharp.format.newLines.inAPropertyPattern": true,
  "csharp.format.newLines.inACSharp10NullableReferenceDirective": true
}
